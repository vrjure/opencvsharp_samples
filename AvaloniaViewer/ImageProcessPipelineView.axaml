<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaViewer.ImageProcessPipelineView">
    <Grid ColumnDefinitions="*,auto"
         RowDefinitions="*,auto">
        <StackPanel Orientation="Vertical">
            <Image Name="ResultImage"></Image>
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Row="1">
            <Image Name="HISTImage"></Image>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top" Grid.RowSpan="2">
            <Button Click="Button_OnClick">Open</Button>
            <Button Click="Button_OnClick">AddMask</Button>
            <Button Click="Button_OnClick">GrayScale</Button>
            <Button Click="Button_OnClick">GaussianBlur</Button>
            <Button Click="Button_OnClick">Threshold</Button>
            <Button Click="Button_OnClick">Morphology</Button>
            <Button Click="Button_OnClick">Contours</Button>
            <Button Click="Button_OnClick">InRange</Button>
            <StackPanel Orientation="Horizontal">
                <Button Click="Button_OnClick">Move+</Button>
                <Button Click="Button_OnClick">Move-</Button>
            </StackPanel>
            <Button Click="Button_OnClick">Rotation</Button>
            <Button Click="Button_OnClick">Affine</Button>
            <Button Click="Button_OnClick">Perspective</Button>
            <Button Click="Button_OnClick">AdaptiveThreshold</Button>
            <Button Click="Button_OnClick">Filter2D</Button>
            <Button Click="Button_OnClick">BilateralFilter</Button>
            <Button Click="Button_OnClick">Gradient</Button>
            <Button Click="Button_OnClick">Pyramid</Button>
            <Button Click="Button_OnClick">HIST</Button>
            <Button Click="Button_OnClick">GrabCut</Button>
        </StackPanel>
    </Grid>
</UserControl>
