<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaViewer.MainWindow"
        Title="AvaloniaViewer"
        Width="1000" Height="750">
        <DockPanel>
                <ListBox SelectionChanged="SelectingItemsControl_OnSelectionChanged">
                        <ListBoxItem Tag="1">Canny Edge Detection</ListBoxItem>
                        <ListBoxItem Tag="2">Video Capture</ListBoxItem>
                        <ListBoxItem Tag="3">FaceDetectorYN</ListBoxItem>
                        <ListBoxItem Tag="4">FaceRecognizer</ListBoxItem>
                        <ListBoxItem Tag="5">Image Process Pipeline</ListBoxItem>
                </ListBox>
                <ContentControl x:Name="PageContent"/>
        </DockPanel>
</Window>
